# ─── Telegram ───────────────────────────────────────────────
BOT_TOKEN=                      # токен бота от @BotFather
SOCKS_PROXY=                    # (опц.) socks5://user:pass@host:port, если запускаете в России, нужен прокси
ADMIN_CHAT_ID=                  # chat_id для фолбэк-уведомлений
ADMIN_CHAT_IDS=                 # дополнительные админы через запятую
GROUP_CHAT_ID=                  # ID группы с темами по вакансиям

# ─── База данных (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ─── Google ─────────────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=./google-credentials.json   # сервисный аккаунт
GOOGLE_SHEETS_ID_USERS=                 # таблица пользователей
GOOGLE_SHEETS_RANGE_USERS=Лист1!A:D
GOOGLE_SHEETS_ID_VACANCIES=             # таблица со списком вакансий
GOOGLE_SHEETS_RANGE_VACANCIES=A:E       # 5-я колонка — email аккаунта HH; все 5 полей обязательны
GOOGLE_SHEETS_ID_CALENDAR=              # таблица-календарь собеседований
GOOGLE_SHEETS_RANGE_CALENDAR=сводная таблица кандидатов (копия)!A:H

# ─── HH.ru OAuth2 ───────────────────────────────────────────
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=                # напр. https://yourdomain/hh-ru/callback
OAUTH_PORT=3000                 # порт локального OAuth-сервера
HH_USER_AGENT=hr-tg-bot/1.0 (you@example.com)
HH_TOKEN_ENCRYPTION_KEY=        # 32 случайных байта: openssl rand -hex 32
HH_HTTP_TIMEOUT_MS=25000
HH_HTTP_RETRIES=2
HH_AUTH_ALERTS=true             # false = не писать в группу о потере/восстановлении доступа

# Одноразовая миграция старого HH-аккаунта (если нужна)
LEGACY_HH_ACCOUNT_EMAIL=
LEGACY_HH_MANAGER_ID=
LEGACY_HH_EMPLOYER_ID=
LEGACY_HH_EMPLOYER_NAME=

# ─── ИИ (OpenAI-совместимый endpoint) ───────────────────────
AI_ENDPOINT=http://localhost:12345/v1/responses
AI_TOKEN=
AI_MODEL=

# ─── Флаги поведения ────────────────────────────────────────
USE_LOCAL_PROCESSING=true       # обрабатывать локально (не через внешний webhook)
HHRU_DRY_RUN=false              # true = не выполнять действия на HH (только анализ)
QUESTIONNAIRE_HH_ACTIONS=true   # включить действия по анкетам (по «Действие HR»)
ANKETA_HR_DRY_RUN=false         # true = только логировать решения по анкетам
CHAT_ROUTER_DRY_RUN=false       # true = роутер чатов только логирует, ничего не шлёт
CHAT_ROUTER_RESPONSE_STAGE=false
ARCHIVED_NOTIFY_DRY_RUN=true
QA_AUTOSAVE=false               # сохранять ручные ответы в лист «Вопрос-ответ»
SCHEDULER_TZ=Europe/Moscow      # часовой пояс планировщика
SHEETS_CACHE_TTL=30000
ANKETA_MIN_DATE=
QUESTIONNAIRE_SOURCE_STORE_PATH=
LIVE_VACANCY_IDS=
HHRU_CONSIDER_BACKFILL_VACANCY_IDS=
HHRU_CONSIDER_BACKFILL_BATCH_SIZE=10

# ─── Веб-панель и публичные анкеты ──────────────────────────
PANEL_PORT=4000
PANEL_BASE=/hr
ANKETA_BASE=/anketa
PUBLIC_ORIGIN=https://example.com
PANEL_PUBLIC_URL=https://example.com/hr
PANEL_USER=admin
PANEL_PASSWORD=
PANEL_SECRET=
PANEL_BOT_LOG_DIR=/root/.pm2/logs
PANEL_BOT_NAME=hr-tg-bot
PANEL_LOG_TAIL=6000
PANEL_BUTTON_EVERY=10

# ─── Тестовый симулятор чатов ───────────────────────────────
CHAT_SIM_PORT=3001

# ─── (опц.) внешние вебхуки, если используется n8n ──────────
N8N_WEBHOOK_HHRU=
N8N_WEBHOOK_QUESTIONNAIRE=
